{
  "Name": "HL7 FHIR Guide Template",
  "Include": [
    "styles/hl7",
    "styles/dependencies/rendering",
    "styles/dependencies/hl7-custom",
    "styles/dependencies/anchorjs@4.1.0",
    "styles/dependencies/jquery@3.7.0",
    "styles/dependencies/jqueryui@1.11.1",
    "styles/dependencies/prism@1.21.0",
    "styles/dependencies/bootstrap@3.4.1",
    "styles/dependencies/clipboard@2.0.0"
  ],
  "CanCopy": true,
  "Description": "This template inherits from the hl7.base.template and adds in the FHIR product family logo and color scheme. This template can only be used when balloting your Implementation Guide with HL7 International. Users are responsible for adhering to HL7 International's guidelines for use of the HL7 International and FHIR logo."
}